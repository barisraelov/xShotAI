# Copy to backend/.env and fill in real values. backend/.env is gitignored.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL DSN. A postgres:// scheme is rewritten to postgresql://.
# DATABASE_URL=postgresql://xshot_user:xshot_password@localhost:5432/xshot_db

# ── Auth / JWT ─────────────────────────────────────────────────────────────
# HMAC key for signing JWTs. Always set this in production.
# SECRET_KEY=change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated allowed origins, or * to allow any (default).
# CORS_ORIGINS=https://x-shot-ai.vercel.app

# ── Email verification (Gmail SMTP) ────────────────────────────────────────
# When SMTP_USER / SMTP_PASS are BOTH set, new registrations must verify their
# email before they can log in. Leave them blank for local dev / CI — accounts
# are then created already-verified and no email is sent.
#
# SMTP_PASS is a Google "App Password" (16 chars), NOT your Google account
# password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465                       # 465 = implicit SSL; use 587 for STARTTLS
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=                          # optional visible From; defaults to SMTP_USER

# Public origin of the frontend, used to build the verification link
# {FRONTEND_URL}/verify-email?token=... Falls back to the local Vite dev server.
FRONTEND_URL=https://x-shot-ai.vercel.app
