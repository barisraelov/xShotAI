# Staging / Vercel Preview — copy values into Vercel Preview env and Railway Staging.
# No secrets. Never point these at Production.
# Do not set VITE_ENABLE_LIVE_PRODUCTION on Staging.
#
# Vercel Preview (frontend):
#   VITE_API_URL=https://YOUR-STAGING-SERVICE.up.railway.app
#   VITE_VERCEL_ENV=preview
#
# Railway Staging (backend) — use a NEW project/service and a NEW empty database.
# Do not copy Production DATABASE_URL.
#   DATABASE_URL=postgresql://USER:PASS@HOST:PORT/STAGING_DB
#   CORS origins must include the Vercel Preview URL
#
# WebSocket: https://YOUR-STAGING-SERVICE.up.railway.app -> wss://YOUR-STAGING-SERVICE.up.railway.app/live
VITE_API_URL=https://YOUR-STAGING-SERVICE.up.railway.app
VITE_VERCEL_ENV=preview
