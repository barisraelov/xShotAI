# Copy to .env and adjust as needed.
#
# Base URL for the xShot AI backend API.
#   empty                -> local Vite dev proxy (vite.config.js) -> localhost:8000
#   https://<staging>     -> Vercel Preview / Railway Staging only
#
# Do NOT set this to the Production Railway API on Preview.
# Preview must use a dedicated Staging VITE_API_URL. Missing VITE_API_URL
# in a production-like build blocks Live instead of falling back to Production.
VITE_API_URL=
#
# Vercel Production only (never Preview / Staging):
#   VITE_ENABLE_LIVE_PRODUCTION=true
#   VITE_VERCEL_ENV=production
# Production VITE_API_URL must be exactly the Railway Production origin.
# Live WebSocket is derived as wss:// from that same origin.
VITE_ENABLE_LIVE_PRODUCTION=false
